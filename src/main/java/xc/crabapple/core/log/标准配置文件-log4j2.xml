<?xml version='1.0' encoding='UTF-8'?>

<configuration status='DEBUG' monitorInterval='30'>

	<properties>
        <property name='FORMAT'>%highlight{[%p] %t %-d{yyyy-MM-dd HH:mm:ss.SSS} %n  %l%n  %m%n}{FATAL=red, ERROR=red, WARN=yellow, INFO=blue, DEBUG=green,TRACE=cyan}</property>
    </properties>

    <appenders>

        <Console name='Console' target='SYSTEM_OUT'>
            <PatternLayout pattern='${FORMAT}'/>
        </Console>
        
        <RollingFile name='FILE_DEBUG' filePattern='/data/crabapple/logs/${date:yyyy-MM-dd}/debug-%d{yyyy-MM-dd}-%i.log'>
            <!--控制台只输出level及以上级别的信息（onMatch），其他的直接拒绝（onMismatch）-->        
            <ThresholdFilter level='DEBUG' onMatch='ACCEPT' />
            <PatternLayout pattern='${FORMAT}' />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size='100 MB' />
            </Policies>
        </RollingFile>
 
        <RollingFile name='FILE_INFO' filePattern='/data/crabapple/logs/${date:yyyy-MM-dd}/info-%d{yyyy-MM-dd}-%i.log'>
            <!--控制台只输出level及以上级别的信息（onMatch），其他的直接拒绝（onMismatch）-->        
            <ThresholdFilter level='INFO' onMatch='ACCEPT' />
            <PatternLayout pattern='${FORMAT}'/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size='100 MB'/>
            </Policies>
        </RollingFile>
 
        <RollingFile name='FILE_WARN' filePattern='/data/crabapple/logs/${date:yyyy-MM-dd}/warn-%d{yyyy-MM-dd}-%i.log'>
           	<ThresholdFilter level='WARN' onMatch='ACCEPT' />
            <PatternLayout pattern='${FORMAT}'/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size='100 MB'/>
            </Policies>
        </RollingFile>
 
        <RollingFile name='FILE_ERROR' filePattern='/data/crabapple/logs/${date:yyyy-MM-dd}/error-%d{yyyy-MM-dd}-%i.log'>
            <PatternLayout pattern='${FORMAT}'/>
            <ThresholdFilter level='ERROR' onMatch='ACCEPT' />
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size='128 MB'/>
            </Policies>
        </RollingFile>
 
    </appenders>
 
    <loggers>

        <root level='INFO'>
            <appender-ref ref='Console'/>
            <appender-ref ref='FILE_DEBUG'/>
            <appender-ref ref='FILE_INFO'/>
            <appender-ref ref='FILE_WARN'/>
            <appender-ref ref='FILE_ERROR'/>
        </root>

        <logger name='com.alibaba' level='ERROR' />
        <logger name='com.baidu' level='ERROR' />
        <logger name='org.springframework' level='ERROR' />
        <logger name='org.apache' level='ERROR' />
        <logger name='org.mybatis' level='ERROR' />
        <logger name='org.activiti' level='ERROR' />

    </loggers>
 
</configuration>