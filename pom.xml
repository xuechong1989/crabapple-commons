    <scm>
        <connection>scm:git:https://github.com/xuechong1989/crabapple-commons.git</connection>
        <developerConnection>scm:git:https://github.com/xuechong1989/crabapple-commons.git</developerConnection>
        <url>https://github.com/xuechong1989/crabapple-commons</url>
        <tag>HEAD</tag>
