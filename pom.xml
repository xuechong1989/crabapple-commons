<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>xc.crabapple</groupId>
    <artifactId>crabapple-base</artifactId>
    <version>21-4.2.00</version>
    <packaging>pom</packaging>

    <name>crabapple-base</name>
    <description>crabapple 基础类库父项目（聚合与公共属性管理）</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>xuechong1989</id>
            <name>xuechong1989</name>
            <url>https://github.com/xuechong1989</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/xuechong1989/crabapple.git</connection>
        <developerConnection>scm:git:https://github.com/xuechong1989/crabapple.git</developerConnection>
        <url>https://github.com/xuechong1989/crabapple</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>crabapple-core</module>
    </modules>

    <properties>
        <crabapple.version>21-4.2.00</crabapple.version>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.clean.plugin>3.5.0</maven.clean.plugin>
        <maven.compiler.plugin>3.15.0</maven.compiler.plugin>
        <maven.resources.plugin>3.5.0</maven.resources.plugin>
        <maven.surefire.plugin>3.5.4</maven.surefire.plugin>
        <maven.enforcer.plugin>3.6.2</maven.enforcer.plugin>
        <junit.version>5.13.4</junit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin}</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>crabapple-21 需要 JDK 21 及以上</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>需要 Maven 3.9 及以上</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 与 crabapple-core 中的 ci profile 对应，避免 -P ci 时提示 profile 不存在 -->
    <profiles>
        <profile>
            <id>ci</id>
        </profile>
    </profiles>

</project>
